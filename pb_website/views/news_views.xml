<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- News List View -->
    <record id="view_pb_news_list" model="ir.ui.view">
        <field name="name">pb.news.list</field>
        <field name="model">pb.news</field>
        <field name="arch" type="xml">
            <list string="News Articles">
                <field name="title"/>
                <field name="date"/>
                <field name="published"/>
                <field name="is_special"/>
            </list>
        </field>
    </record>

    <!-- News Form View -->
    <record id="view_pb_news_form" model="ir.ui.view">
        <field name="name">pb.news.form</field>
        <field name="model">pb.news</field>
        <field name="arch" type="xml">
            <form string="News Article">
                <sheet>
                    <field name="thumbnail" widget="image" class="oe_avatar" options="{'preview_image': 'thumbnail'}"/>
                    <div class="oe_title">
                        <label for="title" class="oe_edit_only"/>
                        <h1>
                            <field name="title" placeholder="Article Title"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="published"/>
                            <field name="is_special"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Body Content" name="body_content">
                            <field name="body" placeholder="Write HTML body here..." widget="html"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_pb_news" model="ir.actions.act_window">
        <field name="name">News Articles</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pb.news</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Write your first website news article!
            </p>
        </field>
    </record>
</odoo>
