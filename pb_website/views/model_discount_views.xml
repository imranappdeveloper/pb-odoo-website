<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Model Discount List View -->
    <record id="view_pb_model_discount_list" model="ir.ui.view">
        <field name="name">pb.model.discount.list</field>
        <field name="model">pb.model.discount</field>
        <field name="arch" type="xml">
            <list string="Model Discounts">
                <field name="model_name"/>
                <field name="discount_percent"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Model Discount Form View -->
    <record id="view_pb_model_discount_form" model="ir.ui.view">
        <field name="name">pb.model.discount.form</field>
        <field name="model">pb.model.discount</field>
        <field name="arch" type="xml">
            <form string="Model Discount">
                <sheet>
                    <group>
                        <group>
                            <field name="model_name" placeholder="e.g. ALPHARD"/>
                            <field name="discount_percent"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Model Discount Window Action -->
    <record id="action_pb_model_discount" model="ir.actions.act_window">
        <field name="name">Model Discounts</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pb.model.discount</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first model discount!
            </p>
        </field>
    </record>

    <!-- Model Discount Menu Item -->
    <menuitem id="menu_pb_website_model_discount"
              name="Model Discounts"
              parent="menu_pb_website_root"
              action="action_pb_model_discount"
              sequence="80"/>
</odoo>
