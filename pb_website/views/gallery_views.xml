<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Gallery List View -->
    <record id="view_pb_gallery_list" model="ir.ui.view">
        <field name="name">pb.gallery.list</field>
        <field name="model">pb.gallery</field>
        <field name="arch" type="xml">
            <list string="Photo Gallery">
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" class="oe_avatar" options="{'size': [60, 60]}"/>
                <field name="name"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <!-- Gallery Form View -->
    <record id="view_pb_gallery_form" model="ir.ui.view">
        <field name="name">pb.gallery.form</field>
        <field name="model">pb.gallery</field>
        <field name="arch" type="xml">
            <form string="Gallery Image">
                <sheet>
                    <group>
                        <field name="image" widget="image" options="{'size': [800, 600]}"/>
                    </group>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Image Description/Alt Text"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Gallery Action -->
    <record id="action_pb_gallery" model="ir.actions.act_window">
        <field name="name">Photo Gallery</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pb.gallery</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Upload the first gallery image!
            </p>
        </field>
    </record>
</odoo>
