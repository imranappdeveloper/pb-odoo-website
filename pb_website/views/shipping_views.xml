<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- EXCEL IMPORT WIZARD ACTION & FORM -->
    <!-- ============================================================ -->
    <record id="action_shipping_schedule_import_wizard" model="ir.actions.act_window">
        <field name="name">Upload / Import Excel Schedule</field>
        <field name="res_model">shipping.schedule.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_shipping_schedule_import_wizard_form" model="ir.ui.view">
        <field name="name">shipping.schedule.import.wizard.form</field>
        <field name="model">shipping.schedule.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Shipping Schedule from Excel">
                <sheet>
                    <div class="alert alert-info" role="alert" style="margin-bottom: 20px;">
                        <i class="fa fa-info-circle me-1"/> 
                        Select your carrier schedule file (<strong>.xls / .xlsx</strong>). Carrier, Vessel, Voyage, Revision, Trade Lanes, and Port Call dates will be automatically extracted across all regions.
                    </div>
                    <group>
                        <field name="file_data" filename="file_name" string="Select Excel File"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" string="Import Schedules" type="object" class="btn-primary" icon="fa-upload"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- SHIPPING SCHEDULE VIEWS -->
    <!-- ============================================================ -->
    <record id="view_shipping_schedule_tree" model="ir.ui.view">
        <field name="name">shipping.schedule.list</field>
        <field name="model">shipping.schedule</field>
        <field name="arch" type="xml">
            <list string="Shipping Schedules">
                <header>
                    <button name="%(action_shipping_schedule_import_wizard)d" 
                            string="Upload / Import Excel Schedule" 
                            type="action" 
                            class="btn-primary" 
                            icon="fa-upload"/>
                </header>
                <field name="name"/>
                <field name="carrier_name"/>
                <field name="vessel_name"/>
                <field name="voyage_no"/>
                <field name="trade_lane"/>
                <field name="revision_no"/>
                <field name="issue_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_shipping_schedule_form" model="ir.ui.view">
        <field name="name">shipping.schedule.form</field>
        <field name="model">shipping.schedule</field>
        <field name="arch" type="xml">
            <form string="Shipping Schedule">
                <header>
                    <button name="action_open_import_wizard" 
                            string="Upload / Import Excel Schedule" 
                            type="object" 
                            class="btn-primary" 
                            icon="fa-upload"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-lock" disabled="1">
                            <div class="o_stat_info">
                                <field name="lock_version" class="o_stat_value"/>
                                <span class="o_stat_text">Lock Version</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="carrier_name"/>
                            <field name="vessel_name"/>
                            <field name="voyage_no"/>
                            <field name="revision_no"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="trade_lane"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Cargo Rules &amp; Restrictions">
                        <group>
                            <field name="allow_ev"/>
                            <field name="allow_hybrid"/>
                            <field name="require_nkkk"/>
                        </group>
                        <group>
                            <field name="cargo_restrictions" placeholder="Special restrictions, e.g. No pure EV/Hydrogen; Hybrid allowed..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Port Calls &amp; Dates">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="call_type"/>
                                    <field name="port_name"/>
                                    <field name="port_code"/>
                                    <field name="eta"/>
                                    <field name="etd"/>
                                    <field name="eta_end"/>
                                    <field name="etd_end"/>
                                    <field name="status" widget="badge" 
                                           decoration-info="status == 'scheduled'"
                                           decoration-warning="status == 'in_transit'"
                                           decoration-success="status == 'completed'"
                                           decoration-danger="status == 'skipped'"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shipping_schedule_search" model="ir.ui.view">
        <field name="name">shipping.schedule.search</field>
        <field name="model">shipping.schedule</field>
        <field name="arch" type="xml">
            <search string="Search Shipping Schedules">
                <field name="voyage_no"/>
                <field name="carrier_name"/>
                <field name="vessel_name"/>
                <field name="trade_lane"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Carrier" name="group_carrier" context="{'group_by': 'carrier_name'}"/>
                    <filter string="Vessel" name="group_vessel" context="{'group_by': 'vessel_name'}"/>
                    <filter string="Trade Lane" name="group_tradelane" context="{'group_by': 'trade_lane'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_shipping_schedule" model="ir.actions.act_window">
        <field name="name">Shipping Schedules</field>
        <field name="res_model">shipping.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_shipping_schedule_search"/>
    </record>
</odoo>
