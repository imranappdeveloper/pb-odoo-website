<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Testimonial List View -->
    <record id="view_pb_testimonial_list" model="ir.ui.view">
        <field name="name">pb.testimonial.list</field>
        <field name="model">pb.testimonial</field>
        <field name="arch" type="xml">
            <list string="Testimonials">
                <field name="name"/>
                <field name="country"/>
                <field name="rating"/>
                <field name="text"/>
            </list>
        </field>
    </record>

    <!-- Testimonial Form View -->
    <record id="view_pb_testimonial_form" model="ir.ui.view">
        <field name="name">pb.testimonial.form</field>
        <field name="model">pb.testimonial</field>
        <field name="arch" type="xml">
            <form string="Testimonial">
                <sheet>
                    <field name="photo" widget="image" class="oe_avatar" options="{'preview_image': 'photo'}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Customer Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="country" placeholder="e.g. Jamaica"/>
                            <field name="rating"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content" name="content">
                            <field name="text" placeholder="Write testimonial text here..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_pb_testimonial" model="ir.actions.act_window">
        <field name="name">Testimonials</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pb.testimonial</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first customer testimonial!
            </p>
        </field>
    </record>
</odoo>
