<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Recruitment Inquiry List View -->
    <record id="view_pb_recruitment_inquiry_list" model="ir.ui.view">
        <field name="name">pb.recruitment_inquiry.list</field>
        <field name="model">pb.recruitment_inquiry</field>
        <field name="arch" type="xml">
            <list string="Recruitment Inquiries">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="recruitment_type"/>
                <field name="state" widget="badge" decoration-info="state == 'new'" decoration-success="state == 'reviewed'" decoration-danger="state == 'closed'"/>
                <field name="submission_date"/>
            </list>
        </field>
    </record>

    <!-- Recruitment Inquiry Form View -->
    <record id="view_pb_recruitment_inquiry_form" model="ir.ui.view">
        <field name="name">pb.recruitment_inquiry.form</field>
        <field name="model">pb.recruitment_inquiry</field>
        <field name="arch" type="xml">
            <form string="Recruitment Inquiry">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="new,reviewed,closed" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Contact Info">
                            <field name="phone" readonly="1"/>
                            <field name="email" widget="email" readonly="1"/>
                            <field name="dob" readonly="1"/>
                        </group>
                        <group string="Application Details">
                            <field name="recruitment_type" readonly="1"/>
                            <field name="submission_date" readonly="1"/>
                            <field name="street_address" readonly="1"/>
                        </group>
                    </group>
                    <group string="Resume Attachment">
                        <field name="resume_filename" invisible="1"/>
                        <field name="resume" filename="resume_filename" widget="binary"/>
                    </group>
                    <notebook>
                        <page string="Message / Cover Letter" name="message">
                            <field name="message" readonly="1" placeholder="Applicant message..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_pb_recruitment_inquiry" model="ir.actions.act_window">
        <field name="name">Recruitment Inquiries</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pb.recruitment_inquiry</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No recruitment inquiries received yet.
            </p>
        </field>
    </record>
</odoo>
