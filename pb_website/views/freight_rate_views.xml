<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Freight Rate List View -->
    <record id="view_pb_freight_rate_list" model="ir.ui.view">
        <field name="name">pb.freight.rate.list</field>
        <field name="model">pb.freight.rate</field>
        <field name="arch" type="xml">
            <list string="Freight Rates">
                <field name="country"/>
                <field name="port"/>
                <field name="rate_per_m3"/>
            </list>
        </field>
    </record>

    <!-- Freight Rate Form View -->
    <record id="view_pb_freight_rate_form" model="ir.ui.view">
        <field name="name">pb.freight.rate.form</field>
        <field name="model">pb.freight.rate</field>
        <field name="arch" type="xml">
            <form string="Freight Rate">
                <sheet>
                    <div class="oe_title">
                        <label for="country" class="oe_edit_only"/>
                        <h1>
                            <field name="country" placeholder="e.g. Kenya"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="port" placeholder="e.g. Mombasa"/>
                            <field name="rate_per_m3"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_pb_freight_rate" model="ir.actions.act_window">
        <field name="name">Freight Rates</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pb.freight.rate</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first destination shipping/freight rate!
            </p>
        </field>
    </record>
</odoo>
