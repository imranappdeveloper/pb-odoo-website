<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Banner List View -->
    <record id="view_pb_banner_list" model="ir.ui.view">
        <field name="name">pb.banner.list</field>
        <field name="model">pb.banner</field>
        <field name="arch" type="xml">
            <list string="Top page banners">
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" class="oe_avatar" options="{'size': [60, 60]}"/>
                <field name="name"/>
                <field name="title"/>
                <field name="subtitle"/>
                <field name="url"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <!-- Banner Form View -->
    <record id="view_pb_banner_form" model="ir.ui.view">
        <field name="name">pb.banner.form</field>
        <field name="model">pb.banner</field>
        <field name="arch" type="xml">
            <form string="Top page banner">
                <sheet>
                    <group>
                        <field name="image" widget="image" options="{'size': [1024, 600]}"/>
                    </group>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Banner Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="title" placeholder="Banner Title"/>
                            <field name="subtitle" placeholder="Banner Subtitle"/>
                        </group>
                        <group>
                            <field name="url" placeholder="e.g. /stock_list.php"/>
                            <field name="sequence"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Banner Action -->
    <record id="action_pb_banner" model="ir.actions.act_window">
        <field name="name">Top page banner</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pb.banner</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first website top page banner!
            </p>
        </field>
    </record>
</odoo>
